using JLD2 
using Optim
using PyPlot

colorvec = ["tab:blue";"tab:orange";"tab:green";"tab:red";"tab:purple";"tab:brown";"tab:pink";"tab:gray";"tab:olive";"tab:cyan";"red"];
bigrange = 25:3:55
smallrange = 4:3:34

# plot minimum vs n 
tval = 3;
dir = "/Users/liambond/Nextcloud/Qudit_PI/data/t$(tval)/";
filelist = readdir(dir)[contains.(readdir(dir),"jld2")]
g_tol = 1e-18; 

plt.close() 
for tval in 1:3 

    minvec = []; nvec = []; 
    for i in eachindex(filelist) 
        if contains(filelist[i],"t$(tval)") && contains(filelist[i],"gtol$(g_tol)")
                nval = load(dir*filelist[i])["n"]
                minval = load(dir*filelist[i])["minimum"]
                push!(minvec,minval)
                push!(nvec,nval)
                if nval == 28 
                    @show minval
                end 
        end
    end 

    ## 

    
    plt.scatter(nvec,minvec)
    plt.yscale("log")
    plt.xlabel("n")
    plt.ylabel("minimum")
    # plt.title("t = $(tval)")
    (tval == 3 || tval == 2) ? plt.xlim([5;80]) : nothing 
    plt.ylim([10^(-18);1^(-1)])
    plt.legend(["t=1","t=2","t=3"])

end 

plt.hlines(10^(-15),0,10000,color="black",ls="dashed")
plt.hlines(10^(-16),0,10000,color="black",ls="dashed")

plt.gcf()


